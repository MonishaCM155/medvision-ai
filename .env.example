# ===========================================================================
# MedVision AI — environment configuration
# Copy this file to `.env` and adjust. Every value is optional; sensible
# defaults are shown. The server validates these on startup (see config.ts).
# ===========================================================================

# --- Server -----------------------------------------------------------------
# Port the Express server listens on. Resolution order: this .env value, then
# process.env.PORT (Render/Heroku assign one), then 3000. Set
# MEDVISION_IGNORE_ENV_PORT=1 to skip the process-env PORT (runtimes that
# inject ephemeral ports).
PORT="3000"
# MEDVISION_IGNORE_ENV_PORT="1"
# development | production — production validates the configuration and fails
# fast with meaningful messages when a value is invalid.
NODE_ENV="development"
# debug | info | warn | error — structured log verbosity (default info).
LOG_LEVEL="info"
# Comma-separated CORS origin whitelist for cross-origin deployments.
# Leave empty for the default same-origin SPA (no CORS headers are sent).
# The FastAPI engine reads this too (fallback: http://localhost:3000).
ALLOWED_ORIGINS=""
# FRONTEND_URL="https://app.example.com"

# Reverse-proxy hop count for rate limiting / audit IPs. OFF by default; set
# TRUST_PROXY=1 (or a hop count) only when deployed behind Render, nginx, or a
# cloud load balancer so req.ip reflects the real client.
# TRUST_PROXY="1"

# --- AI / integration ---------------------------------------------------------
# Gemini API key: enables Gemini-generated reports + copilot responses.
# Falls back to the built-in rule engine when absent.
GEMINI_API_KEY=""
# Gemini model id used for report + copilot synthesis. If the id is invalid,
# requests degrade gracefully to the built-in rule engine.
# GEMINI_MODEL="gemini-3.6-flash"

# Base URL of the FastAPI PyTorch inference engine. When reachable,
# /api/predict and /api/validate run real inference + the AI safety gate
# (type classifier, OOD, quality, calibration, uncertainty).
PYTORCH_ENGINE_URL="http://127.0.0.1:8000"
# FASTAPI_URL is accepted as an alias for PYTORCH_ENGINE_URL.

# --- Public API security (no authentication — MedVision AI is a public
#     research platform; abuse protection replaces login throttling) -----------
# Max requests per IP per minute to expensive endpoints
# (/api/predict, /api/validate, /api/chat, /api/batch-predict). Default 60.
MEDVISION_API_RATE_LIMIT="60"
# Legacy name for the same knob (kept for backward compatibility).
# MEDVISION_RATE_LIMIT="60"

# Maximum upload payload accepted (bytes). Default 27 MB.
# MAX_UPLOAD_SIZE="28311552"

# --- AI safety pipeline --------------------------------------------------------
# Temperature-scaling calibration factor for confidence. 1.0 = identity.
# Values > 1.0 (e.g. 1.4) flatten overconfident probabilities. Clamped [0.2, 5.0].
MEDVISION_TEMPERATURE="1.0"

# Minimum quality score (0-100) for a chest X-ray to pass the safety gate.
QUALITY_THRESHOLD="55"

# Minimum confidence (0.5-0.95) for a definitive diagnosis. Below this, results
# are INDETERMINATE and the definitive report/PDF/DOCX/QR stay locked.
MEDVISION_CONFIDENCE_THRESHOLD="0.75"

# Model version label reported by the engine metadata (defaults to 2.7.0).
# MODEL_VERSION="2.7.0"

# --- Persistence ----------------------------------------------------------------
# Optional PostgreSQL connection string. When set AND the optional `pg` npm
# package is installed, history + audit logs persist to Postgres.
# Otherwise they persist to ./data/medvision-store.json.
DATABASE_URL=""
